# This is the main entry point shell script for cert2.
# It loads the cert2 system in ACL2/raw Lisp and runs it.

set -e

# Find the directory containing this script
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Determine ACL2 executable
if [ -z "$ACL2" ]; then
    # Try to find ACL2 in common locations
    if command -v acl2 &> /dev/null; then
        ACL2="acl2"
    elif [ -x "$SCRIPT_DIR/../../saved_acl2" ]; then
        ACL2="$SCRIPT_DIR/../../saved_acl2"
    else
        echo "Error: Cannot find ACL2 executable." >&2
        echo "Set the ACL2 environment variable or add acl2 to your PATH." >&2
        exit 1
    fi
fi

# Determine system books directory
if [ -z "$ACL2_SYSTEM_BOOKS" ]; then
    # Assume we're in books/build2
    ACL2_SYSTEM_BOOKS="$(cd "$SCRIPT_DIR/.." && pwd)"
fi
export ACL2_SYSTEM_BOOKS

# Disable ACL2 customization
export ACL2_CUSTOMIZATION=NONE

# Create a temporary file for our startup script
STARTUP_FILE=$(mktemp)
trap "rm -f $STARTUP_FILE" EXIT

cat > "$STARTUP_FILE" << 'EOF'
; Startup script for cert2
(value :q)
(in-package "COMMON-LISP")

; We need to handle the case where BUILD2 package doesn't exist yet
(unless (find-package "BUILD2")
  (defpackage "BUILD2"
    (:use "COMMON-LISP")
    (:export "BUILD-TARGETS" "MAIN")))

EOF

# Add the load command
echo "(load \"$SCRIPT_DIR/cert2.lsp\")" >> "$STARTUP_FILE"

# Add the main call with arguments
echo -n "(build2::main '(" >> "$STARTUP_FILE"
for arg in "$@"; do
    # Escape any special characters in arguments
    escaped_arg=$(printf '%s' "$arg" | sed 's/"/\\"/g')
    echo -n "\"$escaped_arg\" " >> "$STARTUP_FILE"
done
echo "))" >> "$STARTUP_FILE"

# Add exit
cat >> "$STARTUP_FILE" << 'EOF'

; Exit with appropriate code
#+sbcl (sb-ext:exit :code 0)
#+ccl (ccl:quit 0)
#-(or sbcl ccl) (cl-user::exit)
EOF

# Run ACL2 with the startup script
# Use --no-init or similar to skip normal ACL2 initialization if available
exec "$ACL2" < "$STARTUP_FILE"
