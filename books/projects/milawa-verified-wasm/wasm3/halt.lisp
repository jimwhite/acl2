;; ---------------------------------------------------------------------------
;; The way into the halt branch's first call
;; ---------------------------------------------------------------------------
;
; The halt branch is the dispatch's then branch: a label 0 around the body
;
;   (:CALL 2) (:TESTOP eqz) (inner abort ifelse) (:CALL 1) ... (:RETURN)
;
; so the first two steps inside the label are the $depth call's read split and
; its entry into function 2's frame.  The read split is halt.lisp's earlier
; work (dctxt-call2/dwlabel-call2); the entry is the six facts below:
;
;   dctxt-call2-entry   the context step at the halt body (the pair at the
;                       head, the suffix spliced back): the k = 1 search
;                       attempt on the lone call_ref fails, k = 0 steps the
;                       pair -- fail-lone-call-ref-list and
;                       dsearch21-call2-k0 are those two slices;
;   dwlabel-call2-entry the label-0 rule around it;
;   dctxt-hlabel-split / dctxt-hcall2-entry
;                       the context step at LABEL 1's body, where the label-0
;                       instruction stands at the head with the rest of the
;                       dispatch after it;
;   dstep-/dlabel6-     the step bridges and the label-1 lifts;
;   douter-             the frame-6 lifts, through the generic frame wrapper.
;
; TWO SPELLINGS, AND WHY.  The label rule runs its body with the pair it is
; given; the frame rule, one level up, builds the SAME pair by accessors
; -- ($sof G1) and ($fof G1) -- so the lifted facts have to be available with
; the pair written that way.  pair-spelled-is-dcallee (dh-pair-spelled) is the
; bridge, and the -sp facts are the bridge's rewrites of the dcallee facts;
; they cost 247 steps each.  In the outer instantiations the pair's components
; are then selected by dh-sof-of-pair/dh-fof-of-pair -- a rewrite rule that
; matches ($sof (list :%;% a b)) but not ($sof (with_global ...)), so the
; store's accessors stay opaque.  The frame wrapper dstep-frame-outer-gen is
; generic in the label body and its result, so every branch's return will use
; it.


(defthm dcallee-pair-shape
  (and (consp (dcallee-pair bytes sp pc clen result w))
       (equal (car (dcallee-pair bytes sp pc clen result w)) :|%;%|)
       (true-listp (cdr (dcallee-pair bytes sp pc clen result w)))
       (equal (len (cdr (dcallee-pair bytes sp pc clen result w))) 2)
       (equal (cadr (dcallee-pair bytes sp pc clen result w))
              (w3t::$sof (w3t::$with_global
                          (list :|%;%| (frozen-store bytes sp pc clen 1 result)
                                (w3t::$frame (w3t::$with_local (iz6 bytes sp pc clen result) 0
                                                               (list :const (list :i32) w))))
                          1 (list :const (list :i32) (dadd pc)))))
       (equal (caddr (dcallee-pair bytes sp pc clen result w))
              (w3t::$fof (w3t::$with_global
                          (list :|%;%| (frozen-store bytes sp pc clen 1 result)
                                (w3t::$frame (w3t::$with_local (iz6 bytes sp pc clen result) 0
                                                               (list :const (list :i32) w))))
                          1 (list :const (list :i32) (dadd pc)))))))

(defthm with-global-shape
  (and (consp (w3t::$with_global z x v))
       (equal (car (w3t::$with_global z x v)) :|%;%|)
       (true-listp (cdr (w3t::$with_global z x v)))
       (equal (len (cdr (w3t::$with_global z x v))) 2))
  :hints (("Goal" :in-theory (enable w3t::$with_global))))

