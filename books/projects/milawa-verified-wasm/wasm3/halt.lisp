;; ---------------------------------------------------------------------------
;; The $depth div: the value's range, and the callee-level step
;; ---------------------------------------------------------------------------
;
; $depth's second instruction is (binop div-u) of SP by 4.  Its value is
; ($truncz (* 1/4 sp)) -- $IDIV_'s value, with the spec's truncation.  For
; the dispatcher to accept the const that holds it, the value has to be a
; valid i32, i.e. un-p ... 32.  That is the arithmetic below:
;
;   numerator-when-integer, rational-is-numerator-over-denominator
;                    the two ways to read rational-implies2;
;   nniq-rational-bound
;                    floor(n/d) <= n/d, via arithmetic/mod-gcd's division
;                    algorithm facts (Nonneg-int-mod-*);
;   nniq-of-numerator-bound, floor-1-bound2
;                    the integer-part bound floor(x,1) < 2^32 for x in
;                    [0, 2^32), both denominator cases;
;   truncz-value     un-p ($truncz (* 1/4 sp)) 32 from un-p sp 32.
;
; The bound proofs need :nonlinearp t, and nniq-of-numerator-bound needs
; nniq-rational-bound DISABLED in its :use hint (it is a linear rule; leaving
; it enabled makes the use disappear into the linear procedure).
;
; Then the callee-level div step: ddiv-slice (the pure binop rule at the
; callee pair), ddiv-label (its label), dhdiv-frame (the frame rule at the
; outer pair) and dhdiv-ctxt (the halt body's context step).  Each carries
; (un-p sp 32) because the pure rule's val-p check needs the value's range.
;
; OPEN: the label-0 lift of this step.  The halt block's body ends in
; (:RETURN), so with the div value inside the frame, the pure dispatcher
; explores Step_pure/return-label, whose step_pure/search141 ACL2 will not
; reduce by rewriting (it needs the search's definition instance at the
; literal k).  s141-nil proves for the POST-div body (one const) but not for
; the pre-div body (the binop instruction makes the search's length/take
; conditions case-split and stall).  The next attempt should give the label
; proof a search141 nil fact for the exact pre-div body, established with the
; definition instance at the search's own (tag-lo, len) arguments.

(include-book "arithmetic/mod-gcd" :dir :system)

(defthm numerator-when-integer (implies (and (rationalp x) (equal (denominator x) 1)) (equal (numerator x) x)) :hints (("Goal" :nonlinearp t :use ((:instance acl2::rational-implies2 (x x))))))

(defthm rational-is-numerator-over-denominator (implies (rationalp x) (equal (/ (numerator x) (denominator x)) x)) :hints (("Goal" :nonlinearp t :use ((:instance acl2::rational-implies2 (x x))))))

(defthm nniq-rational-bound (implies (and (integerp n) (<= 0 n) (integerp d) (< 0 d) (rationalp x) (equal x (/ n d))) (<= (nonnegative-integer-quotient n d) x)) :hints (("Goal" :nonlinearp t :use ((:instance acl2::Nonneg-int-mod-nonnegative-integer-quotient) (:instance acl2::Nonneg-int-mod-<-divisor)))))

