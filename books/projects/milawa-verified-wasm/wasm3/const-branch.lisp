                             (:IFELSE (:_RESULT NIL) ((:CALL 4) (:RETURN)) NIL)
                             (:GLOBAL.GET 1)
                             (:LOAD (:I32) NIL 0 (:%REC (:ALIGN . 2) (:OFFSET . 0)))
                             (:LOCAL.SET 1)
                             (:GLOBAL.GET 1)
                             (:CONST (:I32) 4)
                             (:BINOP (:I32) (:ADD))
                             (:GLOBAL.SET 1)
                             (:LOCAL.GET 1)
                             (:CALL 0)
