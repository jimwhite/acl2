; This is the first book that depends on the WebAssembly semantics, so it is also
; where the dependency is dealt with.  wasm-acl2 is pinned (clone, not vendored)
; and lives outside the community books tree; see
; ../../../milawa/VERIFIED-WASM-LISP.md section 3.4 for the pin, the build and the
; reproducibility check.  The books in THIS directory are listed in
; ../cert_pl_exclude so that a community certification run never has to find it.
;
; WHAT IS PROVED HERE, AND WHAT IS NOT.  The module below is the pinned module as
; a ground term; every theorem in this book is a logic-mode fact about it, so
; W3T::STEP -- which IS logic mode -- can be reasoned about in later books.
;
; What cannot be a theorem is that the artifact decodes to it.  W3T::GRAM/BMODULE
; and W3T::$INSTANTIATE are in :program mode in the generated 3.0 books: the
; binary decoder and the instantiator are executable but not logic functions, so
; neither can appear in a theorem.  (Measured, not assumed: see the note at the
; end of this file.)  So the bytes -> module step is a SCRIPT
; (../harness/gen_module.py, which runs ../harness/decode.lsp), and the module
; constant is generated by it.  The residual trust is one line of execution of the
; certified decoder, and it is discharged by re-running the script rather than by
; argument -- which is also why the script fails loudly if the decode changes.
;
; The consequence for the plan is real and worth stating plainly: the chain from
; BYTES to a theorem runs through a trusted step.  Section 3.4 of the design
; document claimed the binary decoder being inside the formal model meant the
; shipped file could be the subject of the theorem; that is true of the decoder's
; CODE but not of its USE, because of the mode.  Options, in order of preference:
; get the decoder into logic mode (it is generated, so this is a translator
; question, not a proof question); or accept the script and say so in the trust
; table.

(in-package "MILAWA-WASM")

; The pinned tree, by absolute path: the one place to edit if the pin moves, or if
; the clone lives somewhere else.  (ADD-INCLUDE-BOOK-DIR would be tidier, but
; cert.pl loads these forms before the book's own events have run, so a :DIR key
; registered inside the book is not yet legal when the include is processed.)
(include-book "../wasm-acl2/translate/gen/wasm-3.0/wasm3")

(include-book "module")

;; ---------------------------------------------------------------------------
;; The module is well formed
;; ---------------------------------------------------------------------------

(defthm milawa-verified-module-is-well-formed
  (w3t::module-p *milawa-verified-module*))

;; ---------------------------------------------------------------------------
;; The artifact's shape, as theorems
;;
;; The module's fields are positional: (NTH I (CDR MODULE)) for I = 0..10, in the
;; order the spec's module record gives them.  Measured on this artifact by
;; printing each field's tag: types at 0, globals at 3, mems at 4, funcs at 6,
;; exports at 10, and NIL everywhere else (1, 2, 5, 7, 8, 9 -- so no imports, no
;; tables, no tags, no rec groups, no elements, no data segments).
;;
;; These are ground facts, so they are proved by evaluation; what makes them worth
;; stating is that WABT is untrusted.  An assembler that dropped the memory or
;; mangled an export would leave the proofs about the model intact and break the
;; runtime, and these are the theorems that would catch it.
;; ---------------------------------------------------------------------------

(defthm milawa-verified-export-count
  (equal (len (nth 10 (cdr *milawa-verified-module*))) 8))

(defthm milawa-verified-function-count
  (equal (len (nth 6 (cdr *milawa-verified-module*))) 12))

(defthm milawa-verified-global-count
  (equal (len (nth 3 (cdr *milawa-verified-module*))) 5))

(defthm milawa-verified-memory-count
  (equal (len (nth 4 (cdr *milawa-verified-module*))) 1))

; No imports and no data segments: the module takes nothing from the host and
; carries its code in its own bodies, which is why instantiation needs no externs
; and why L2 has no import hypothesis to carry.
(defthm milawa-verified-imports-and-data-are-empty
  (and (equal (nth 1 (cdr *milawa-verified-module*)) nil)
       (equal (nth 2 (cdr *milawa-verified-module*)) nil)
       (equal (nth 5 (cdr *milawa-verified-module*)) nil)
       (equal (nth 7 (cdr *milawa-verified-module*)) nil)
       (equal (nth 8 (cdr *milawa-verified-module*)) nil)
       (equal (nth 9 (cdr *milawa-verified-module*)) nil)))

;; ---------------------------------------------------------------------------
;; The interface, by name
;; ---------------------------------------------------------------------------

; Export names are byte lists in the syntax.  "step" is the function L1 is about;
; pinning its INDEX here is what lets the next book say which body to reason
; about instead of searching the export list every time.

(defun milawa-export-names (exports)
  (declare (xargs :guard t
                  :verify-guards nil))
  (if (consp exports)
      (cons (car (cdr (car exports)))
            (milawa-export-names (cdr exports)))
    nil))

(defthm milawa-verified-export-names
  (equal (milawa-export-names (nth 10 (cdr *milawa-verified-module*)))
         '((109 101 109 111 114 121)                     ; memory
           (114 101 115 101 116)                         ; reset
           (115 116 101 112)                             ; step
           (115 116 97 116 117 115)                      ; status
           (114 101 115 117 108 116)                     ; result
           (112 99)                                      ; pc
           (115 112)                                     ; sp
           (99 111 100 101 95 98 97 115 101))))          ; code_base

; "step" is function 6, which is the body L1 refines against MVM-STEP.

(defthm milawa-verified-step-is-function-6
  (member-equal '(:export (115 116 101 112) (:func 6))
                (nth 10 (cdr *milawa-verified-module*))))

;; ---------------------------------------------------------------------------
;; The layout, recorded for whoever writes the next book
;;
;; A :MODULE value has 11 fields, in this order, each a list of field records or
;; NIL when absent (measured on this artifact by printing (cdr module)):
;;
;;   0 types      2 (:TYPE ...) records
;;   1 NIL
;;   2 NIL
;;   3 globals    5 (:GLOBAL (mut?) (const type value)) records
;;   4 memory     1 (:MEMORY (:PAGE (:I32) (bounds 1 NIL))) record
;;   5 NIL
;;   6 funcs     12 (:FUNC typeidx locals body) records
;;   7..10       the remaining fields; exports are among these
;;
;; Module-level facts are read with field indexing, as the generated code does,
;; not with W3T::%GET-FIELD: (%GET-FIELD STORE :FUNCS) works, because a store's
;; fields are alist-shaped records, but (%GET-FIELD MODULE :EXPORTS) does not --
;; it answers with something that is not the export list.  Pinning down the exact
;; indices for exports and functions is the first thing the L1 book needs and is a
;; five-minute job once a theorem needs them, so it is not guessed here.
;;
;; The other artifact-level check is a script, not a theorem: the decoder is in
;; :program mode, so ../harness/gen_module.py re-decodes the .wasm and requires a
;; complete parse (PARSE-REST=0) and an unchanged module.
