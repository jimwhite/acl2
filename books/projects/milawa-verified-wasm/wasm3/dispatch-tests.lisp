; fetch.lisp ends with the shared fetch's positions and the first two tests
; (HALT and CONST).  This book carries the rest of the dispatch: the
; ADD/SUB/LT OR-chain and its block/label, the IFZ test, the JMP test, each
; position with the context/label/frame recipe, and the constants 5 and 6 of
; the last two tests.  Splitting it off keeps the fetch certificate at a few
; minutes; the positions after the OR-chain are the expensive ones because
; every ifelse/block frame lift's measure sees the whole remaining dispatch
; (~27M steps each).

(in-package "MILAWA-WASM")

(include-book "fetch")

