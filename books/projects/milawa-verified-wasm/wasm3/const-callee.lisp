(in-package "MILAWA-WASM")

(include-book "const-branch")

; L1, the CONST path's tail, part 3: the callee's positions read1, sub,
; read2, mul and ltu at the run's states, lifted through the label 0/rest,
; the label 1 and the outer frame.
;
; THE LABEL-0 RECIPE (measured): the body-level ctxt facts live at the
; book's BUILDER spellings (dadmin/dbodyK/const-rest), but the label-0 lift
; needs its premises at the DATA spelling -- the evaluated instruction list
; with (milawa-callee-frame 3) as a call and the symbolic values as
; (car (w3t::$binop_ ...)) terms -- because the label rule's pure trap
; search must evaluate.  The generic lift is LABEL-LIFT-GENERAL-N (any
; label number); its seven premises (step_pure/step_read of the body and of
; the lone label, both size conditions, and the match135/search141 nil
; facts) are proved at the data spelling and handed in with
; step_pure/step_read/split DISABLED in the label-0 proof.
;
; Each group: ctxt-d/step-d (the data spelling, from the builder fact via
; :rule-classes nil bridges), the seven premises, the label 0, the
; label-0/rest slice, the label-1 premises, the label 1 and the frame.

(set-prover-step-limit 8000000)
(include-book "const-branch")

(defthm label-lift-general-n
  (implies (and (true-listp body)
                (true-listp body2)
                (equal (w3t::step_pure body) nil)
                (equal (w3t::step_read/split (list :|%;%| z body)) nil)
                (equal (w3t::step/r-ctxt-instrs (list :|%;%| z body))
                       (list (list :|%;%| z2 body2)))
                (equal (w3t::step_pure (list (list :label_%{%}% n nil body))) nil)
                (equal (w3t::step_read/split
                        (list :|%;%| z (list (list :label_%{%}% n nil body)))) nil)
                (< (w3t::%size body)
                   (w3t::%size (list (list :label_%{%}% n nil body)))))
           (equal (w3t::step (list :|%;%| z (list (list :label_%{%}% n nil body))))
                  (list (list :|%;%| z2 (list (list :label_%{%}% n nil body2))))))
  :hints (("Goal" :in-theory (disable w3t::step_pure w3t::step_read/split w3t::step/r-ctxt-instrs)
           :use ((:instance (:definition w3t::step/r-ctxt-label)
                            (w3t::%a0 (list :|%;%| z (list (list :label_%{%}% n nil body)))))
                 no-ctxt-instrs-on-a-lone-label-general))))

