; All false-comparison skips of the dispatcher (generated by DEF-SKIP).
;
(in-package "MILAWA-WASM")
(include-book "ops-dispatch-gen")

(defmacro def-skip (op j)
  (let ((name (acl2::packn-pos (list "SKIP-" op "-" j) (quote milawa-wasm))))
    `(defthm ,name
       (equal
        (car
         (w3t::step
          (car
           (w3t::step
            (car
             (w3t::step
              (car
               (w3t::step
                (car
                 (w3t::step
                  (list :|%;%|
                        (list :|%;%| *ir-store* (dframe ,op a b))
                        (append (dispatch-cmp ,j)
                                (dispatch-tail ,j)))))))))))))
        (list :|%;%| (list :|%;%| *ir-store* (dframe ,op a b))
              (dispatch-tail ,j)))
       :hints (("Goal"
                :in-theory (e/d (d-local-get-rest
                                   d-relop-false-rest
                                   d-ifelse-false-rest
                                   d-block-rest
                                   d-label-nil-rest
                                   dispatch-cmp
                                   dispatch-branch
                                   dispatch-tail
                                   true-listp-dispatch-tail
                                   true-listp-dispatch-branch)
                                (w3t::step dframe ir-frame-with-locals))
                :do-not-induct t)))))

(def-skip 1 0)
(def-skip 2 0)
(def-skip 2 1)
(def-skip 1 0)
(def-skip 2 0)
(def-skip 2 1)
(def-skip 3 0)
(def-skip 3 1)
(def-skip 3 2)
(def-skip 4 0)
(def-skip 4 1)
(def-skip 4 2)
(def-skip 4 3)
(def-skip 5 0)
(def-skip 5 1)
(def-skip 5 2)
(def-skip 5 3)
(def-skip 5 4)
(def-skip 6 0)
(def-skip 6 1)
(def-skip 6 2)
(def-skip 6 3)
(def-skip 6 4)
(def-skip 6 5)
(def-skip 7 0)
(def-skip 7 1)
(def-skip 7 2)
(def-skip 7 3)
(def-skip 7 4)
(def-skip 7 5)
(def-skip 7 6)
