; MILAWA-RUN is a function: a fuel-counted loop.  The WASM 3.0 semantics we are
; going to refine it against is a *relation* (W3T::STEP is given by inference
; rules), and reasoning about relations is easiest with rule induction.  So the
; machine gets a relational presentation too, using std/util's DEFINDUCTIVE
; (Coglio and Jurgensen, ACL2 Workshop 2026), and the rules it generates are
; what L1 will compare a WASM module against.
;
; MILAWA-RUNS C N R FTBL says: from configuration C the machine takes exactly N
; steps and stops with result R.
;
;   halt: C's next step already finishes, so one step suffices.
;   step: C's next step continues to C2, and C2 reaches R in N steps.
;
; A configuration is (MODE OBJ ENV STACK), the four arguments of MILAWA-RUN.

(in-package "ACL2")

(include-book "metatheory")
(include-book "std/util/definductive" :dir :system)

;; ---------------------------------------------------------------------------
;; Configurations
;; ---------------------------------------------------------------------------

(defun milawa-conf (mode obj env stack)
  (declare (xargs :guard t))
  (list mode obj env stack))

(defun milawa-conf-step (c ftbl)
  (declare (xargs :guard t
                  :verify-guards nil))
  (milawa-step (nth 0 c) (nth 1 c) (nth 2 c) (nth 3 c) ftbl))

(defun milawa-conf-run (c ftbl n)
  (declare (xargs :guard t
                  :verify-guards nil))
  (milawa-run (nth 0 c) (nth 1 c) (nth 2 c) (nth 3 c) ftbl n))

(defthm milawa-conf-run-of-make-conf
  (equal (milawa-conf-run (milawa-conf mode obj env stack) ftbl n)
         (milawa-run mode obj env stack ftbl n))
  :hints (("Goal" :in-theory (enable milawa-conf-run milawa-conf))))

(defthm milawa-conf-step-of-make-conf
  (equal (milawa-conf-step (milawa-conf mode obj env stack) ftbl)
         (milawa-step mode obj env stack ftbl))
  :hints (("Goal" :in-theory (enable milawa-conf-step milawa-conf))))

;; ---------------------------------------------------------------------------
;; The step relation
;; ---------------------------------------------------------------------------

(definductive milawa-runs-definition
  :short "Inference rules for the machine reaching a result."
  :long
  (xdoc::topstring
   (xdoc::p
    "Rule @('halt') says that if the next step already finishes the machine,
     one step suffices.  Rule @('step') says that if the next step continues to
     @('c2'), a run from @('c') is one step longer than a run from @('c2').")
   (xdoc::p
    "This is the shape of the WebAssembly specification's @('STEP') relation,
     which is also given by inference rules.  The rules generated by
     @(tsee definductive) are @('milawa-runs-halt') and @('milawa-runs-step')."))

  :preds ((milawa-runs c n r ftbl))

  ; The machine's own functions carry :VERIFY-GUARDS NIL (they are about the
  ; logic of the evaluator, not about fast execution), so the generated
  ; recognizers cannot be guard-verified either.
  :verify-guards nil

  :irules
  ((halt ((not (equal (car (milawa-conf-step c ftbl)) :run)))
         (milawa-runs c 1 (milawa-conf-step c ftbl) ftbl))

   (step ((equal (milawa-conf-step c ftbl) (cons :run c2))
          (milawa-runs c2 n r ftbl))
         (milawa-runs c (+ 1 n) r ftbl))))

;; ---------------------------------------------------------------------------
;; What each rule says about the step count
;; ---------------------------------------------------------------------------

; One-line consequences of the generated per-rule validity predicates
; (MILAWA-RUNS-STEP-VALIDP contains (EQUAL _N (+ 1 N)) literally).

(defthm milawa-runs-halt-validp-count
  (implies (milawa-runs-halt-validp c n r ftbl c0 ftbl0)
           (equal n 1))
  :rule-classes nil
  :hints (("Goal" :in-theory (enable milawa-runs-halt-validp))))

(defthm milawa-runs-step-validp-count
  (implies (milawa-runs-step-validp c n r ftbl c0 c2 ftbl0 n0 r0)
           (equal n (+ 1 n0)))
  :rule-classes nil
  :hints (("Goal" :in-theory (enable milawa-runs-step-validp))))

;; ---------------------------------------------------------------------------
;; The relation is usable
;; ---------------------------------------------------------------------------

; Two steps on (quote 5): evaluate the constant, then return it to the empty
; stack, which finishes the machine.  The rules must be instantiated by hand
; because MILAWA-RUNS-STEP has a free variable (the continuation C2), so it
; cannot be used as a backchaining rewrite rule.

(defthm milawa-runs-of-quote
  (milawa-runs (milawa-conf :eval '(quote 5) nil nil) 2 (milawa-ok 5) nil)
  :hints (("Goal"
           :in-theory (enable milawa-runs-halt
                              milawa-runs-step
                              milawa-conf-step
                              milawa-conf
                              milawa-step)
           :use ((:instance milawa-runs-halt
                            (c (milawa-conf :return 5 nil nil))
                            (ftbl nil))
                 (:instance milawa-runs-step
                            (c (milawa-conf :eval '(quote 5) nil nil))
                            (c2 (milawa-conf :return 5 nil nil))
                            (n 1)
                            (r (milawa-ok 5))
                            (ftbl nil))))))

;; ---------------------------------------------------------------------------
;; The elimination principle
;;
;; We want to reason FROM a derivation, which is what an inductive predicate's
;; elimination principle is for.  DEFINDUCTIVE proves one for us:
;; MILAWA-RUNS-ALT-WHEN-MILAWA-RUNS, for any predicate closed under the two
;; rules.  (MILAWA-RUNS-ALT is a constrained function; MILAWA-RUNS-ALT-HALT and
;; MILAWA-RUNS-ALT-STEP are its constraints.)  So instantiate ALT with
;; MILAWA-RUNS-GOODP and discharge the two constraints by functional
;; instantiation.  No unfolding of MILAWA-RUNS is involved: it is stored as "a
;; minimal valid proof tree exists", so unfolding it drags in the whole
;; minimality machinery and explodes.
;;
;; Note what GOODP is: the shape fact CONJOINED WITH the relation itself.
;; Keeping the relation in the property is what makes the step rule's premise
;; recoverable; without it the step case would have nothing to conclude.
;;
;; The step function and its helpers stay DISABLED in the closure proofs:
;; MILAWA-CONF-STEP is the term the rules mention, and expanding it into
;; MILAWA-STEP's twenty branches turns one subgoal into about a hundred and
;; fifty, none of them closer to done.
;; ---------------------------------------------------------------------------

(defun milawa-runs-goodp (c n r ftbl)
  (declare (xargs :guard t
                  :verify-guards nil))
  (and (milawa-runs c n r ftbl)
       (let ((s (milawa-conf-step c ftbl)))
         (if (equal (car s) :run)
             (and (integerp n)
                  (< 1 n)
                  (milawa-runs (cdr s) (1- n) r ftbl))
           (and (equal n 1)
                (equal r s))))))

(defthm milawa-runs-goodp-halt
  (implies (not (equal (car (milawa-conf-step c ftbl)) :run))
           (milawa-runs-goodp c 1 (milawa-conf-step c ftbl) ftbl))
  :hints (("Goal" :in-theory (e/d (milawa-runs-goodp milawa-runs-halt)
                                  (milawa-conf-step milawa-conf
                                   milawa-step milawa-apply-or-run
                                   milawa-apply-step milawa-apply-primitive)))))

(defthm milawa-runs-goodp-step
  (implies (and (equal (milawa-conf-step c ftbl) (cons :run c2))
                (milawa-runs-goodp c2 n r ftbl))
           (milawa-runs-goodp c (+ 1 n) r ftbl))
  :hints (("Goal" :in-theory (e/d (milawa-runs-goodp milawa-runs-step)
                                  (milawa-conf-step milawa-conf
                                   milawa-step milawa-apply-or-run
                                   milawa-apply-step milawa-apply-primitive)))))

; Stored with :RULE-CLASSES NIL.  As a rewrite rule this is a loop: it rewrites
; (MILAWA-RUNS C N R FTBL) to (MILAWA-RUNS-GOODP C N R FTBL), whose first
; conjunct is (MILAWA-RUNS C N R FTBL) again.
;
; COST: about ten minutes of prover time (measured: 583 s of a 598 s event).
; ACL2 has to discharge the ALT-STEP constraint, whose conclusion is
; (GOODP C (+ 1 N) R FTBL); the relation conjunct of that has to be re-derived
; by MILAWA-RUNS-STEP, and the rewriter specialises N to 1 via the HALT closure
; lemma first, after which (+ 1 N) no longer matches the intro rule.  Restricting
; the theory makes the constraint unprovable, so the slow version is the one
; that works.  This is accepted for now: correctness first.  A faster proof
; wants explicit :USE instantiations of the two intro rules for the shapes ACL2
; actually reaches.

(defthm milawa-runs-elimination
  (implies (milawa-runs c n r ftbl)
           (milawa-runs-goodp c n r ftbl))
  :rule-classes nil
  :hints (("Goal" :by (:functional-instance
                       milawa-runs-alt-when-milawa-runs
                       (milawa-runs-alt milawa-runs-goodp)))))

