(in-package "MILAWA-WASM")

(include-book "mvm")

; The machine starts running at word 0 with an empty stack and no result, which is
; also what the module's own reset leaves behind.
(defun example-init (code)
  (mvm-make-state 1 0 nil 0 code))

; Examples are proved with a generous fuel: the number of steps actually spent is
; one of the things asserted, so a budget that is merely large enough cannot hide
; a slow program.  (MVM-RUN-MONOTONE says a larger budget changes nothing once the
; machine has stopped, which is why this is safe.)
(defconst *example-fuel* 1000)

; halted result=3 steps=4 pc=6
(assert-event
 (let ((code '(1 1  1 2  2  0)))
   (and
     (mvm-haltedp (mvm-run (example-init code) *example-fuel*))
     (equal (mvm-result (mvm-run (example-init code) *example-fuel*)) 3)
     (equal (mvm-steps (example-init code) *example-fuel*) 4)
     (equal (mvm-pc (mvm-run (example-init code) *example-fuel*)) 6))))

; halted result=22 steps=6 pc=9
(assert-event
 (let ((code '(1 3  1 1  3  1 20  2  0)))
   (and
     (mvm-haltedp (mvm-run (example-init code) *example-fuel*))
     (equal (mvm-result (mvm-run (example-init code) *example-fuel*)) 22)
     (equal (mvm-steps (example-init code) *example-fuel*) 6)
     (equal (mvm-pc (mvm-run (example-init code) *example-fuel*)) 9))))

