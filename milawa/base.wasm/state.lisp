;; Recreate the definitions of the admitted functions.
(dolist (entry *defined-functions-table*)
  (destructuring-bind (name formals body inlinep) entry
    (when inlinep
      (eval (list 'declaim (list 'inline name))))
    (eval (list 'defun name formals
                (list 'declare (cons 'ignorable formals))
                body))))
