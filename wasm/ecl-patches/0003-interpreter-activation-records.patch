+/*******************
+ * INTERPRETER ACTIVATION RECORDS
+ *******************
+ * The bytecode interpreter (interpreter.d) keeps the state of each activation
+ * in one of these records instead of C local variables, so that calling an
+ * interpreted function from interpreted code does not consume C stack.  This
+ * matters where the C stack is small and fixed, as in a WebAssembly VM.
+ *
+ * Records are handed out from chunks which are never moved, because the
+ * interpreter's frame objects (struct ecl_stack_frame), its invocation history
+ * frames and the frame stack itself all hold pointers into them.  The chunks
+ * are scanned conservatively by the garbage collector (see alloc_2.d), which is
+ * what keeps the objects the records refer to alive.
+ */
+
+#define ECL_TRAMP_CHUNK_SIZE 512
+
+struct ecl_interp_state {
+        cl_object frame;        /* Frame with the incoming arguments */
+        cl_object bytecodes;    /* Function being executed */
+        cl_object lex_env;      /* Environment of its closure */
+        cl_object lcl_env;      /* Local frame; points at .lcl */
+        cl_object aux_env;      /* Frame for callees; points at .aux */
+        cl_object dat_env;      /* Vector of constants */
+        cl_object reg0;
+        cl_object reg1;
+        void *pc;               /* Next instruction */
+        cl_object *data;        /* dat_env->vector.self.t */
+        cl_index frame_index;   /* Next argument to pop */
+        cl_index narg;
+        cl_index nlcl;
+        int outermost;          /* Owns the C activation of ecl_interpret */
+        struct ecl_stack_frame aux;
+        struct ecl_stack_frame lcl;
+        struct ecl_ihs_frame ihs;
+};
+
+struct ecl_interp_chunk {
+        struct ecl_interp_chunk *next;
+        struct ecl_interp_state recs[ECL_TRAMP_CHUNK_SIZE];
+};
+
 #ifdef __cplusplus
 }
