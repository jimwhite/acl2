+/* ---------------------------------------------------------------------------
+ * ACTIVATION RECORDS
+ *
+ * Calling an interpreted function from interpreted code used to recurse through
+ * ecl_apply_from_stack_frame, which costs a C stack frame -- and, under a
+ * WebAssembly VM, a VM stack frame -- for every Lisp call.  There is room for
+ * tens of thousands of Lisp frames in the Lisp stacks but only for about a
+ * thousand VM frames, so we now keep the state of each activation in a record
+ * (struct ecl_interp_state, see stacks.h): calling an interpreted function
+ * starts a new record and restarts the dispatch loop on the callee, and OP_EXIT
+ * pops back to the caller.  Compiled functions are still called through
+ * ecl_apply_from_stack_frame and may re-enter ecl_interpret below us.
+ *
+ * Records are allocated in chunks which never move, because the frame objects,
+ * the invocation history frames and the frame stack all keep pointers into
+ * them.  The chunks are malloc'ed, so ecl_mark_env offers them to the collector;
+ * otherwise the objects a record refers to would be invisible to it.
+ *
+ * env->tramp_top counts the live records.  _ecl_frs_push saves it in each frame
+ * and ecl_unwind restores it, so that a THROW, RETURN-FROM, GO or an error,
+ * which longjmp out of arbitrarily many activations, leaves it consistent.
+ * ------------------------------------------------------------------------- */
+
+#define TRAMP_STATE(env,idx) \
+        (&(env)->tramp_chunks[(idx) / ECL_TRAMP_CHUNK_SIZE] \
+                          ->recs[(idx) % ECL_TRAMP_CHUNK_SIZE])
+
+/* Allocate the record for a new activation.  The caller fills it in. */
+static struct ecl_interp_state *
+tramp_push(cl_env_ptr the_env)
+{
+  cl_index idx = the_env->tramp_top;
+  cl_index c = idx / ECL_TRAMP_CHUNK_SIZE;
+  struct ecl_interp_chunk *chunk;
+
+  if (ecl_unlikely(c >= the_env->tramp_nchunks)) {
+    cl_index i, nsize = c + 8;
+    struct ecl_interp_chunk **chunks;
+    ecl_disable_interrupts_env(the_env);
+    chunks = (struct ecl_interp_chunk **)ecl_malloc(nsize * sizeof(*chunks));
+    for (i = 0; i < nsize; i++)
+      chunks[i] = (i < the_env->tramp_nchunks)? the_env->tramp_chunks[i] : NULL;
+    if (the_env->tramp_chunks) ecl_free(the_env->tramp_chunks);
+    the_env->tramp_chunks = chunks;
+    the_env->tramp_nchunks = nsize;
+    ecl_enable_interrupts_env(the_env);
+  }
+  chunk = the_env->tramp_chunks[c];
+  if (chunk == NULL) {
+    chunk = (struct ecl_interp_chunk *)ecl_malloc(sizeof(*chunk));
+    chunk->next = NULL;
+    the_env->tramp_chunks[c] = chunk;
+  }
+  the_env->tramp_top = idx + 1;
+  return &chunk->recs[idx % ECL_TRAMP_CHUNK_SIZE];
+}
