--- a/src/c/time.d
+++ b/src/c/time.d
@@ -72,7 +72,15 @@
 void
 ecl_get_internal_run_time(struct ecl_timeval *tv)
 {
-#ifdef HAVE_GETRUSAGE
+#if defined(__EMSCRIPTEN__)
+  /* Emscripten implements neither getrusage() nor times(), but it does
+   * implement clock().  Without this branch every call -- and ACL2 makes
+   * several per event -- prints "unsupported syscall: __syscall_getrusage"
+   * on stderr and returns an undefined value. */
+  clock_t c = clock();
+  tv->tv_sec = c / CLOCKS_PER_SEC;
+  tv->tv_usec = ((c % CLOCKS_PER_SEC) * 1000000) / CLOCKS_PER_SEC;
+#elif defined(HAVE_GETRUSAGE)
   struct rusage r;
   getrusage(RUSAGE_SELF, &r);
   tv->tv_usec = r.ru_utime.tv_usec;
