// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/devcontainers/templates/tree/main/src/ubuntu
{
	"name": "Ubuntu",
	// Or use a Dockerfile or Docker Compose file. More info: https://containers.dev/guide/dockerfile
	"image": "mcr.microsoft.com/devcontainers/base:resolute",
	"features": {
		"ghcr.io/devcontainer-community/devcontainer-features/collection-c-cpp:1": {},
		// Provides git-lfs, so the LFS-tracked files in this repository can be
		// read (see books/projects/aleo/vm/circuits/samples/.gitattributes).
		// autoPull is disabled to avoid downloading large LFS objects on
		// every container creation; run "git lfs pull" when you need them.
		"ghcr.io/devcontainers/features/git-lfs:1": {
			"autoPull": false
		}
	},

	// Features to add to the dev container. More info: https://containers.dev/features.
	// "features": {},

	// Use 'forwardPorts' to make a list of ports inside the container available locally.
	// "forwardPorts": [],

	// Installs Clozure CL (CCL), the default ACL2 host Lisp, and completes the
	// user-level git-lfs setup.
	"postCreateCommand": "bash .devcontainer/setup.sh"

	// Configure tool-specific properties.
	// "customizations": {},

	// Uncomment to connect as root instead. More info: https://aka.ms/dev-containers-non-root.
	// "remoteUser": "root"
}
